# Doudouventaire — l'accès à l'espace privé.
# Copie ce fichier vers .env et change les deux valeurs. Le .env n'est pas versionné.

ADMIN_USER=maman
ADMIN_PASSWORD=change-moi

# Le port par lequel on arrive sur le site : http://localhost:<PORT>
PORT=8000

# À mettre à true seulement derrière un vrai https (le cookie de session
# n'est alors plus envoyé en clair).
SECURE_COOKIES=false

# --- L'annonce des anniversaires ---
# L'adresse du webhook. Sur Discord : Paramètres du salon -> Intégrations ->
# Webhooks -> Nouveau webhook -> Copier l'URL. Vide, rien n'est envoyé.
WEBHOOK_URL=

# discord (défaut) ou slack
WEBHOOK_FORMAT=discord

# L'heure du tour quotidien, et le fuseau dans lequel la lire.
NOTIFY_AT=09:00
TZ=Europe/Brussels
